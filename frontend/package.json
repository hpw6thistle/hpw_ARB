{
  "name": "hotel-budget-anonymous-demo",
  "version": "1.8.0-demo.0",
  "type": "module",
  "scripts": {
    "dev:demo": "vite --mode demo --host 127.0.0.1 --port 5051 --strictPort --open /demo.html",
    "build:demo": "tsc -b && vite build --mode demo && node scripts/check-demo.mjs",
    "preview:demo": "vite preview --mode demo --host 127.0.0.1 --port 5051 --strictPort",
    "test:demo": "playwright test --config playwright.demo.config.ts",
    "dev": "npm run dev:demo",
    "build": "npm run build:demo",
    "preview": "npm run preview:demo",
    "test": "npm run test:demo"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
